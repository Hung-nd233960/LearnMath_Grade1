{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm test && npm run build && mkdir -p dist/guide && cp -r docs/guide/. dist/guide/ && rm dist/guide/README.md",
  "outputDirectory": "dist",
