{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tham tu Toan hoc",
  "version": "0.1.0",
  "identifier": "vn.thamtutoanhoc.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "title": "Thám tử Toán học Tí hon",
        "width": 1180,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Thám tử Toán học Tí hon",
    "windows": { "nsis": { "languages": ["English"], "installMode": "currentUser" } }
  }
}
